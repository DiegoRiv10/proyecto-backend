# ---- Base de datos PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=canchapp

# ---- Cadena de conexión que usa la API (SQLAlchemy) ----
# El host "db" es el nombre del servicio de Postgres en docker-compose.
DATABASE_URL=postgresql://postgres:postgres@db:5432/canchapp

# ---- Configuración de la aplicación ----
APP_TITLE=CanchApp API
